# 文枢 WenQu · npm / pnpm 国内镜像
# 提交到仓库，协作者 clone 后自动生效，无需各自配置。
# 如需恢复官方源，临时覆盖：npm install --registry=https://registry.npmjs.org

registry=https://registry.npmmirror.com/

# 二进制下载镜像（原生模块编译 / Electron 等场景会用到）
node_mirror=https://registry.npmmirror.com/-/binary/node/
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
sass_binary_site=https://registry.npmmirror.com/-/binary/node-sass/

# 安装体验：跳过资助信息与审计，加快 install
fund=false
audit=false
