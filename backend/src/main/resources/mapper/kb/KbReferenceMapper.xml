<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="xyz.cbt.wenqu.backend.modules.kb.mapper.KbReferenceMapper">
  <select id="findModelById" resultType="xyz.cbt.wenqu.backend.modules.kb.mapper.LlmModelProjection">
    SELECT id, name, type, dimension, enabled FROM llm_model WHERE id = #{id}
  </select>
  <select id="findSettingValue" resultType="java.lang.String">
    SELECT value FROM sys_setting WHERE key = #{key}
  </select>
</mapper>
